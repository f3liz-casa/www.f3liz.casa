# Copy to .kamal/secrets (gitignored) and fill, or export in your shell / direnv / 1Password.
#   cp .kamal/secrets.example .kamal/secrets

# data.go.kr 서비스키（버스위치정보 / 버스노선정보 API 用）。1行、URLエンコード前の生キー。
# このマシンなら ~/sandbox/tago/.tago_key にある:  TAGO_KEY=$(cat ~/sandbox/tago/.tago_key)
TAGO_KEY=$TAGO_KEY

# 箱ローカル registry(127.0.0.1:5000) の basic-auth pass。sukhi と同じもの（user=sukhi）を流用。
REGISTRY_PASSWORD=$REGISTRY_PASSWORD

# Cloudflare Origin CA 証明書（*.f3liz.casa, Full (Strict)）。sukhi と同じ 1 枚を共有してよい。
# config/tls/origin.crt, origin.key を手で置く（sukhi-deploy から流用）。
TLS_CERT=$(cat config/tls/origin.crt)
TLS_KEY=$(cat config/tls/origin.key)
